# OpenSQS Docker image — no authentication
#
# Purpose:
#   Run OpenSQS with authentication disabled. Any client can send and
#   receive messages without providing credentials. Ideal for local
#   development, CI pipelines, and quick testing where you don't want
#   to manage access keys.
#
# Usage:
#   docker build -f examples/docker/Dockerfile.no-auth -t opensqs-no-auth .
#   docker run -p 9324:9324 -p 9325:9325 opensqs-no-auth
#
#   Or use the pre-built image:
#   docker run -p 9324:9324 -p 9325:9325 \
#     ghcr.io/tguidoux/opensqs/opensqs-server:latest \
#     --config /etc/opensqs/config.yaml
#
# Ports:
#   9324 — SQS API
#   9325 — Web UI
#
# See: examples/docker/README.md

FROM ghcr.io/tguidoux/opensqs/opensqs-server:latest

COPY config.no-auth.yaml /etc/opensqs/config.yaml

EXPOSE 9324 9325
