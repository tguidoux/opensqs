# OpenSQS Docker image — with initial credentials
#
# Purpose:
#   Run OpenSQS with authentication enabled and pre-seeded credentials.
#   The server starts with a known access key / secret key pair so your
#   AWS CLI or SDK can talk to it immediately without creating credentials
#   via the Web UI first.
#
# Usage:
#   docker build -f examples/docker/Dockerfile.with-creds -t opensqs-with-creds .
#   docker run -p 9324:9324 -p 9325:9325 opensqs-with-creds
#
# Ports:
#   9324 — SQS API
#   9325 — Web UI
#
# Credentials (from config.with-creds.yaml):
#   AccessKeyId:     AKIAIOSFODNN7EXAMPLE
#   SecretAccessKey: wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
#
# See: examples/docker/README.md

FROM ghcr.io/tguidoux/opensqs/opensqs-server:latest

COPY config.with-creds.yaml /etc/opensqs/config.yaml

ENV CONFIG_PATH=/etc/opensqs/config.yaml

EXPOSE 9324 9325
