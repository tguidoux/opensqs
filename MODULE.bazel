"""
opensqs project.
"""

module(name = "opensqs")

########################################
# Setings
########################################

GO_VERSION = "1.25.5"

########################################
# Generic deps
########################################
bazel_dep(name = "bazel_lib", version = "3.3.1", repo_name = "bazel_lib")
bazel_dep(name = "tar.bzl", version = "0.10.5")
bazel_dep(name = "yq.bzl", version = "0.3.6")
bazel_dep(name = "platforms", version = "1.1.0", repo_name = "platforms")

yq = use_extension("@yq.bzl//yq:extensions.bzl", "yq")
yq.toolchain(name = "opensqs_yq")
use_repo(yq, "opensqs_yq_toolchains")

register_toolchains("@opensqs_yq_toolchains//:all")

# Register the local platform configuration repo
platforms_extension = use_extension("@platforms//host:extension.bzl", "host_platform")
use_repo(platforms_extension, "host_platform")

########################################
# Set up rules_go
########################################
bazel_dep(name = "rules_go", version = "0.61.1", repo_name = "rules_go")
bazel_dep(name = "gazelle", version = "0.51.3", repo_name = "bazel_gazelle")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = GO_VERSION)
go_sdk.nogo(nogo = "//:nogo")

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# All direct imports should be listed here
use_repo(
    go_deps,
    "com_github_dgraph_io_badger_v4",
    "com_github_goccy_go_yaml",
    "com_github_prometheus_client_golang",
    "com_github_prometheus_client_model",
    "com_github_stretchr_testify",
    "org_golang_x_time",
    "org_modernc_sqlite",
)

# go_deps.gazelle_override(
#     path = "github.com/smacker/go-tree-sitter",
#     build_file_generation = "auto",
# )
# go_deps.module_override(
#     patches = [
#         "//patches:go-tree-sitter-build.patch",
#         "//patches:go-tree-sitter-python.patch",
#     ],
#     path = "github.com/smacker/go-tree-sitter",
# )

########################################
# Set up hermetic Buildifier tools
########################################
# This is helpful because the old version used an http_archive to fetch the buildtools
# WORKSPACE, but it is incompatible with bzlmod Go toolchains. Instead let's just use
# a prebuilt version.
bazel_dep(
    name = "buildifier_prebuilt",
    version = "8.2.1.1",
    repo_name = "buildifier_prebuilt",
)

########################################
# Set up rules_pkg
########################################
bazel_dep(name = "rules_pkg", version = "1.2.0")

########################################
# Set up hermetic C/C++ tools
########################################
# NOTE: We don't really use/support C/C++ in this repo, and if you need to you'll
# almost certainly want your own proper toolchains to do so, but rules_oci requires
# CC toolchains to be registered for packaging OCI images, so we will cheat a
# little using zig/hermetic_cc_toolchain to provide cross-compilation toolchains for
# packaging OCI images.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0", repo_name = "hermetic_cc_toolchain")

toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(toolchains, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_gnu.2.31",
    "@zig_sdk//toolchain:linux_arm64_gnu.2.31",
)
# bazel_dep(name = "toolchains_musl", version = "0.1.27", dev_dependency = True)

########################################
# Set up rules_oci
########################################
bazel_dep(name = "rules_oci", version = "2.3.0", repo_name = "rules_oci")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_base",
    # 'latest' is not reproducible, but it's convenient.
    # During the build we print a WARNING message that includes recommended 'digest' and 'platforms'
    # values which you can use here in place of 'tag' to pin for reproducibility.
    # tag = "latest",
    digest = "sha256:9d4e5680d67c984ac9c957f66405de25634012e2d5d6dc396c4bdd2ba6ae569f",
    image = "gcr.io/distroless/base",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
)
oci.pull(
    name = "ubuntu_base",
    # tag = "26.04",
    digest = "sha256:c397f5aeae1d761068ccca300c50ab7de4ec1aaafee5e399d81ec2634f94082f",
    image = "ubuntu",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
)

# For each oci.pull call, repeat the "name" here to expose them as dependencies.
use_repo(oci, "distroless_base", "distroless_base_linux_amd64", "distroless_base_linux_arm64_v8", "ubuntu_base", "ubuntu_base_linux_amd64", "ubuntu_base_linux_arm64_v8")

########################################
# Set up bazel_skylib
########################################
bazel_dep(name = "bazel_skylib", version = "1.9.0", repo_name = "bazel_skylib")

bazel_dep(name = "bazel_skylib_gazelle_plugin", version = "1.9.0", dev_dependency = True)

########################################
# Register shell toolchain
########################################
bazel_dep(name = "rules_shell", version = "0.8.0")
