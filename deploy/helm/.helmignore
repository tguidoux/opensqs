# Patterns to ignore when building Helm packages.
# Operates similar to .gitignore.
# Common VCS files
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.idea/
.vscode/
*.iml
# OS generated files
.DS_Store
Thumbs.db
# Project files
*.md
